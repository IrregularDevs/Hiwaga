%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 155f4c80966429842a894125a411ec78, type: 3}
  m_Name: Benito_0
  m_EditorClassIdentifier: 
  npcRefName: Benito
  dialogueIndex: 0
  dialogueLines:
  - dialogueLine: Hello there traveller, my name is Benito and I am the servant of
      the King.
    character: {fileID: 11400000, guid: c4564917bcf1ba446a138385d899cc9c, type: 2}
    typingSpeed: 0.05
    autoProgressDelayFast: 1
    autoProgressDelaySlow: 3
  - dialogueLine: You seem lost and yet it feels like you know where you are headed.
    character: {fileID: 11400000, guid: c4564917bcf1ba446a138385d899cc9c, type: 2}
    typingSpeed: 0.05
    autoProgressDelayFast: 1
    autoProgressDelaySlow: 3
  - dialogueLine: Perhaps you would like to accompany me and help with my journey?
    character: {fileID: 11400000, guid: c4564917bcf1ba446a138385d899cc9c, type: 2}
    typingSpeed: 0.05
    autoProgressDelayFast: 1
    autoProgressDelaySlow: 3
  - dialogueLine: Greetings Benito, I am &name, a traveller from distant lands.
    character: {fileID: 11400000, guid: ba529eb23a50322489b9aededacb9480, type: 2}
    typingSpeed: 0.05
    autoProgressDelayFast: 1
    autoProgressDelaySlow: 3
  - dialogueLine: I am also on a quest in search of myself.
    character: {fileID: 11400000, guid: ba529eb23a50322489b9aededacb9480, type: 2}
    typingSpeed: 0.05
    autoProgressDelayFast: 1
    autoProgressDelaySlow: 3
  - dialogueLine: I would be honored to join hands with you on your journey.
    character: {fileID: 11400000, guid: ba529eb23a50322489b9aededacb9480, type: 2}
    typingSpeed: 0.05
    autoProgressDelayFast: 1
    autoProgressDelaySlow: 3
  - dialogueLine: May I ask what is the purpose of yours and where you are headed?
    character: {fileID: 11400000, guid: ba529eb23a50322489b9aededacb9480, type: 2}
    typingSpeed: 0.05
    autoProgressDelayFast: 1
    autoProgressDelaySlow: 3
  - dialogueLine: The king has ordered me to bring him a beautiful princess who lives
      in a land across the sea.
    character: {fileID: 11400000, guid: c4564917bcf1ba446a138385d899cc9c, type: 2}
    typingSpeed: 0.05
    autoProgressDelayFast: 1
    autoProgressDelaySlow: 3
  - dialogueLine: And if I fail I will be severely punished.
    character: {fileID: 11400000, guid: c4564917bcf1ba446a138385d899cc9c, type: 2}
    typingSpeed: 0.05
    autoProgressDelayFast: 1
    autoProgressDelaySlow: 3
  - dialogueLine: That sounds tragic and frightening, my friend.
    character: {fileID: 11400000, guid: ba529eb23a50322489b9aededacb9480, type: 2}
    typingSpeed: 0.05
    autoProgressDelayFast: 1
    autoProgressDelaySlow: 3
  - dialogueLine: And yet despite that, why did you still go and take this task?
    character: {fileID: 11400000, guid: ba529eb23a50322489b9aededacb9480, type: 2}
    typingSpeed: 0.05
    autoProgressDelayFast: 1
    autoProgressDelaySlow: 3
  - dialogueLine: Because deep down despite my fears, I must find the courage to
      face these trials.
    character: {fileID: 11400000, guid: c4564917bcf1ba446a138385d899cc9c, type: 2}
    typingSpeed: 0.05
    autoProgressDelayFast: 1
    autoProgressDelaySlow: 3
  - dialogueLine: 'Not only for myself, but also for my family. '
    character: {fileID: 11400000, guid: c4564917bcf1ba446a138385d899cc9c, type: 2}
    typingSpeed: 0.05
    autoProgressDelayFast: 1
    autoProgressDelaySlow: 3
  autoProgressLines: 
  loops: 0
  questToGive: {fileID: 0}
