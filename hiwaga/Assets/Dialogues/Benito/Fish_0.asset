  m_Script: {fileID: 11500000, guid: 155f4c80966429842a894125a411ec78, type: 3}
  m_Name: Fish_0
  m_EditorClassIdentifier: 
  npcRefName: King Of Fishes
  dialogueIndex: 0
  dialogueLines:
  - dialogueLine: Hello dear travellers, I bid you my greetings.
    character: {fileID: 11400000, guid: 65400c17707956b43828fcb144b98daa, type: 2}
    typingSpeed: 0.05
    autoProgressDelayFast: 1
    autoProgressDelaySlow: 3
  - dialogueLine: 'I am on a quest to see the beautiful princess from a faraway land. '
    character: {fileID: 11400000, guid: c4564917bcf1ba446a138385d899cc9c, type: 2}
    typingSpeed: 0.05
    autoProgressDelayFast: 1
    autoProgressDelaySlow: 3
  - dialogueLine: May I ask why you look distraught?
    character: {fileID: 11400000, guid: 65400c17707956b43828fcb144b98daa, type: 2}
    typingSpeed: 0.05
    autoProgressDelayFast: 1
    autoProgressDelaySlow: 3
  - dialogueLine: 'Sadly, I do not have a way to cross the vast sea to reach her. '
    character: {fileID: 11400000, guid: c4564917bcf1ba446a138385d899cc9c, type: 2}
    typingSpeed: 0.05
    autoProgressDelayFast: 1
    autoProgressDelaySlow: 3
  - dialogueLine: Well, get on my back dear friends. I shall carry the both of you
      across the vast sea.
    character: {fileID: 11400000, guid: 65400c17707956b43828fcb144b98daa, type: 2}
    typingSpeed: 0.05
    autoProgressDelayFast: 1
    autoProgressDelaySlow: 3
  autoProgressLines: 
  loops: 0
  questToGive: {fileID: 0}
