  dialogueLines:
  - dialogueLine: So...
    character: {fileID: 11400000, guid: 72026ee90f07baf4aa120533f2a6578e, type: 2}
    typingSpeed: 0.05
    autoProgressDelayFast: 1
    autoProgressDelaySlow: 2
  - dialogueLine: How was the first part of your journey with the young man, Benito?
    character: {fileID: 11400000, guid: 72026ee90f07baf4aa120533f2a6578e, type: 2}
    typingSpeed: 0.05
    autoProgressDelayFast: 1
    autoProgressDelaySlow: 3
  - dialogueLine: Despite it being a small step towards the end of the journey, I
      feel like I quite connect and understand Benito despite being faced with struggles
      and challenges.
    character: {fileID: 11400000, guid: ba529eb23a50322489b9aededacb9480, type: 2}
    typingSpeed: 0.05
    autoProgressDelayFast: 1
    autoProgressDelaySlow: 3
  - dialogueLine: He keeps on pushing forward despite everything.
    character: {fileID: 11400000, guid: ba529eb23a50322489b9aededacb9480, type: 2}
    typingSpeed: 0.05
    autoProgressDelayFast: 1
    autoProgressDelaySlow: 3
  - dialogueLine: I cannot wait to see what else comes in store for me.
    character: {fileID: 11400000, guid: ba529eb23a50322489b9aededacb9480, type: 2}
    typingSpeed: 0.05
    autoProgressDelayFast: 1
    autoProgressDelaySlow: 3
